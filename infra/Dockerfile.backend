FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY pyproject.toml ./
RUN pip install --upgrade pip && \
    pip install fastapi uvicorn[standard] sqlalchemy psycopg2-binary pydantic[email] \
    openai scikit-learn pandas numpy requests python-multipart \
    apscheduler resend stripe python-jose[cryptography] passlib[bcrypt]

# Copy the rest of the application
COPY . .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]