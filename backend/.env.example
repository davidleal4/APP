# Environment variables for development
# Copy this file to .env and fill in your actual values

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
USE_POSTGRES=False
DB_NAME=ai_influencer
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Stripe (TODO: Add your Stripe keys)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# AWS (TODO: Add your AWS credentials)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_STORAGE_BUCKET_NAME=ai-influencer-media
AWS_S3_REGION_NAME=us-east-1

# Hugging Face (TODO: Add your Hugging Face token)
HUGGINGFACE_API_TOKEN=hf_your_token_here

# Analytics (TODO: Add your analytics keys)
MIXPANEL_PROJECT_TOKEN=your_mixpanel_token_here
POSTHOG_API_KEY=your_posthog_key_here